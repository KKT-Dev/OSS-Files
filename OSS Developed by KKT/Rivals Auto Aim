end)

local function isVisible(startPos, targetPart)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {lp.Character, targetPart.Parent}
    raycastParams.IgnoreWater = true
    local targetPos = targetPart.Position
    local size = targetPart.Size
    local checkPoints = {
        targetPos,
        targetPos + Vector3.new(size.X/2, 0, 0),
        targetPos + Vector3.new(-size.X/2, 0, 0),
        targetPos + Vector3.new(0, size.Y/2, 0),
        targetPos + Vector3.new(0, -size.Y/2, 0),
        targetPos + Vector3.new(0, 0, size.Z/2),
        targetPos + Vector3.new(0, 0, -size.Z/2),
        targetPos + Vector3.new(size.X/3, size.Y/3, 0),
        targetPos + Vector3.new(-size.X/3, size.Y/3, 0),
        targetPos + Vector3.new(size.X/3, -size.Y/3, 0),
        targetPos + Vector3.new(-size.X/3, -size.Y/3, 0),
    }
    local visibleCount = 0
    local totalChecks = #checkPoints
    for _, point in ipairs(checkPoints) do
        local direction = (point - startPos).Unit
        local distance = (point - startPos).Magnitude
        if distance < 0.5 then
            visibleCount = visibleCount + 1
        else
            local raycastResult = workspace:Raycast(startPos, direction * distance, raycastParams)
            
            if not raycastResult then
                visibleCount = visibleCount + 1
            else
                local hitPart = raycastResult.Instance
                local targetChar = targetPart.Parent
                if hitPart and targetChar and hitPart:IsDescendantOf(targetChar) then
                    visibleCount = visibleCount + 1
                end
            end
        end
    end
    return (visibleCount / totalChecks) >= 0.7
end
local function isFullyVisible(cameraPos, character)
    local head = character:FindFirstChild("HeadHB") or character:FindFirstChild("Head")
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    if not head and not torso then
        return false
    end
    local headVisible = false
    local torsoVisible = false
    if head then
        headVisible = isVisible(cameraPos, head)
    end
    if torso then
        torsoVisible = isVisible(cameraPos, torso)
    end
    if headVisible then
        return true
    elseif torsoVisible then
        return true
    end
    
    return false
end
local function isFriend(player)
    for _, friendName in pairs(getgenv().Friends) do
        if player.Name == friendName or player.DisplayName == friendName then
            return true
        end
    end
    return false
end

local function get_target()
    local target = nil
    local dist = getgenv().FOV
    local mouse = uis:GetMouseLocation()
    local character = lp.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not rootPart then return nil end
    local cameraPos = cam.CFrame.Position

    for _, v in pairs(plrs:GetPlayers()) do
        if v ~= lp and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if isFriend(v) then
                continue
            end
            local targetChar = v.Character
            if getgenv().WallCheck then
                if not isFullyVisible(cameraPos, targetChar) then
                    continue
                end
            end
            local part = targetChar:FindFirstChild("HeadHB") or targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("HumanoidRootPart")
            if part then
                local distance = (part.Position - rootPart.Position).Magnitude
                if distance > getgenv().MaxDistance then
                    continue
                end
                local pos, on_screen = cam:WorldToViewportPoint(part.Position)
                if on_screen then
                    local mag = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if mag < dist then
                        dist = mag
                        target = part
                    end
                end
            end
        end
    end
    return target
end
