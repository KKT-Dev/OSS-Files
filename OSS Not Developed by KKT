local function getTargetName()
    local lbl = getModalElement("PlayerNameLabel")
    if lbl and lbl:IsA("TextLabel") then
        local t = (lbl.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" and not t:find("not found", 1, true) and not t:find("Can't gift", 1, true) then
            return t:gsub("^@", "")
        end
    end
    local box = getModalElement("UsernameInput")
    if box and box:IsA("TextBox") then
        local t = (box.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then return t:gsub("^@", "") end
    end
    return giftUser
end

local function resolveGiftByType(giftType)
    if not giftType then return nil end
    local data = GiftConfig.ALL_GIFTS[giftType]
    if not data then return nil end

    local price = priceCache[giftType]
    if not price and data.DevProductId then
        local info = productInfo(data.DevProductId)
        price = (info and info.price > 0) and info.price or 99
        priceCache[giftType] = price
    end
    price = price or 99

    preloadImage(data.Image)

    return {
        display = data.Name .. " - Gift",
        price = price,
        bundle = bundleFor(price),
        was = math.floor(price * 1.25),
        image = data.Image,
        raw = data.Name,
        giftType = giftType,
        devProductId = data.DevProductId,
    }
end

local function resolveGiftByDevProductId(id)
    if not id then return nil end
    local meta = GiftConfig.PRODUCT_TO_GIFT[id]
    if meta and meta.Type then
        return resolveGiftByType(meta.Type)
    end
    for typeKey, data in pairs(GiftConfig.ALL_GIFTS) do
        if data.DevProductId == id then
            return resolveGiftByType(typeKey)
        end
    end
end

local function resolveGiftByGamepassId(gpId)
    if not gpId then return nil end
    for typeKey, data in pairs(GiftConfig.TREADMILL_GIFTS) do
        if data.GamepassId == gpId then
            return resolveGiftByType(typeKey)
        end
    end
end

local function resolveCurrentGift()
