local function interceptPurchase(id, isGamepass)
    if not on or promptOpen then return false end
    local item = isGamepass and resolveGiftByGamepassId(id) or resolveGiftByDevProductId(id)
    if not item then
        item = resolveCurrentGift()
    end
    if not item then return false end
    task.defer(function()
        if on and not promptOpen then
            showPrompt(item)
        end
    end)
    return true
end

local function disableConnections(signal, btn)
    if not getconnections then return end
    giftSaved[btn] = giftSaved[btn] or {}
    for _, conn in ipairs(getconnections(signal)) do
        table.insert(giftSaved[btn], conn)
        pcall(function() conn:Disable() end)
    end
end

local function restoreGiftButtons()
    if getconnections then
        for btn, conns in pairs(giftSaved) do
            if btn.Parent then
                for _, conn in ipairs(conns) do
                    pcall(function() conn:Enable() end)
                end
            end
        end
    end
    table.clear(giftSaved)
    for _, d in ipairs(CS:GetTagged("GiftToPlayer")) do
        if d:IsA("GuiButton") then
            d:SetAttribute("_svGift", nil)
        end
    end
end

local function hookSendGiftButton(btn)
    if not btn:IsDescendantOf(pg) or not btn:IsA("GuiButton") then return end
    if btn:GetAttribute("Type") ~= "SendGiftButton" then return end
    if btn:GetAttribute("_svGift") then return end
    btn:SetAttribute("_svGift", true)

    disableConnections(btn.Activated, btn)
    disableConnections(btn.MouseButton1Click, btn)

    local function onSend()
        if not on or promptOpen then return end
        local giftType = getGiftType()
        if not giftType then return end
        local who = getTargetName()
        if not who or who == "" then return end
        local item = resolveGiftByType(giftType)
        if item then showPrompt(item) end
    end

    btn.Activated:Connect(onSend)
    btn.MouseButton1Click:Connect(onSend)
end

local function scanGiftButtons()
    if not on then return end
    for _, btn in ipairs(CS:GetTagged("GiftToPlayer")) do
        hookSendGiftButton(btn)
    end
end

local function installHooks()
    if hooks.installed then return end

    if hookmetamethod then
        local fn = function(self, ...)
            if on and self == MS and not promptOpen then
                local method = getnamecallmethod()
                if MS_BLOCK[method] then
                    local args = { ... }
                    local id = typeof(args[2]) == "number" and args[2] or args[1]
                    if typeof(id) == "number" then
                        local isGp = method == "PromptGamePassPurchase"
                        if interceptPurchase(id, isGp) then
                            return
                        end
                    end
                end
            end
            return hooks.oldNamecall(self, ...)
        end
        hooks.oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(fn) or fn)
    end

    hooks.giftAdded = CS:GetInstanceAddedSignal("GiftToPlayer"):Connect(function()
        if on then task.defer(scanGiftButtons) end
    end)

    hooks.descConn = pg.DescendantAdded:Connect(function()
        if on then task.defer(scanGiftButtons) end
    end)

    hooks.scanTask = task.spawn(function()
        while on do
            scanGiftButtons()
            task.wait(0.75)
        end
    end)

    scanGiftButtons()

    hooks.coreConn = game:GetService("CoreGui").DescendantAdded:Connect(function(obj)
        if not on or promptOpen or tick() < coreBlockUntil then return end
        if obj:IsA("TextLabel") and obj.Text == "Buy Robux and item" then
            local sg = obj:FindFirstAncestorWhichIsA("ScreenGui")
            if sg and sg.Name ~= "SV_FakeBuy" then
                pcall(function() sg:Destroy() end)
                task.defer(function()
                    if not on or promptOpen or tick() < coreBlockUntil then return end
                    local item = resolveCurrentGift() or resolveGiftByDevProductId(getGiftType())
                    if item then showPrompt(item) end
                end)
            end
        end
    end)

    hooks.installed = true
end

local function removeHooks()
    if hooks.oldNamecall and hookmetamethod then
        pcall(function() hookmetamethod(game, "__namecall", hooks.oldNamecall) end)
    end
    if hooks.giftAdded then pcall(function() hooks.giftAdded:Disconnect() end) end
    if hooks.descConn then pcall(function() hooks.descConn:Disconnect() end) end
    if hooks.coreConn then pcall(function() hooks.coreConn:Disconnect() end) end
    restoreGiftButtons()
    hooks = {}
    closePrompt()
end

