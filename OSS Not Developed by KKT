local function setContentCreator(enabled)
    ccOn = enabled
    installCCHook()
    installRankHook()

    if ccCharConn then
        ccCharConn:Disconnect()
        ccCharConn = nil
    end
    if ccMaintainer then
        ccMaintainer = nil
    end

    pcall(function()
        if enabled then
            if ClientState and ClientState.Data then
                ClientState.Data.ContentCreator = true
                ClientState.Data.ManualContentCreator = true
                ClientState.Data.DisplayTag = CCConfig.label
                ClientState.Data.ChatPrefix = CCConfig.chatPrefix
                ClientState.Data.GroupRank = CCConfig.rank
                ClientState.Data.ActiveGroupTag = CCConfig.key
            end
            ccCharConn = plr.CharacterAdded:Connect(function(char)
                task.wait(0.35)
                applyOverheadTag(char)
            end)
            ccMaintainer = task.spawn(function()
                while ccOn do
                    local char = plr.Character
                    if char then
                        softenNativeTagBackground(char)
                        if not ccBillboard or not ccBillboard.Parent then
                            applyOverheadTag(char)
                        end
                    end
                    task.wait(1.5)
                end
            end)
            refreshContentCreatorTag()
        else
            clearOverheadTag()
            if ClientState then
                ClientState:Update({
                    ContentCreator = false,
                    ManualContentCreator = false,
                })
                if ClientState.Data then
                    ClientState.Data.ContentCreator = nil
                    ClientState.Data.ManualContentCreator = nil
                    ClientState.Data.DisplayTag = nil
                    ClientState.Data.ChatPrefix = nil
                    ClientState.Data.GroupRank = nil
                    ClientState.Data.ActiveGroupTag = nil
                end
            end
        end
    end)

    if ccBtn then
        ccBtn.Text = enabled and "Content Creator ON" or "Content Creator OFF"
        ccBtn.BackgroundColor3 = enabled and Color3.fromRGB(255, 66, 138) or Color3.fromRGB(30, 41, 59)
    end
end
local function bundleFor(price)
    local steps = { 400, 500, 800, 1000, 1700, 2000, 3400, 4000 }
    for _, s in ipairs(steps) do
        if s >= price then return s end
    end
    return math.ceil(price * 1.25 / 100) * 100
end

local function productInfo(id)
    local ok, info = pcall(MS.GetProductInfo, MS, id, Enum.InfoType.Product)
    if not ok or not info then return nil end
    return { name = info.Name, price = info.PriceInRobux or 0 }
end

