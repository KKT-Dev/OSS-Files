local function fmt(n)
    local s = tostring(math.floor(n))
    return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function toUsd(robux)
    return math.floor((robux or 0) * 0.012 * 100) / 100
end

local function fmtUsd(robux)
    return string.format("$ %.2f", toUsd(robux))
end

local function setFakeRobux(amount)
    amount = math.clamp(math.floor(tonumber(amount) or 0), cfg.robuxMin, cfg.robuxMax)
    fakeRobux = amount
    if balLbl then balLbl.Text = fmt(fakeRobux) end
    if robuxSliderFill and robuxSliderKnob then
