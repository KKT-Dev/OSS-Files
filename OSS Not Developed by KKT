local function softenNativeTagBackground(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("GuiObject") and obj.Name:lower():find("tag") then
            if obj:IsA("TextLabel") or obj:IsA("Frame") or obj:IsA("TextButton") then
                local t = (obj.Text or obj.Name or ""):lower()
                if t:find("content creator") or t:find("contentcreator") then
                    obj.BackgroundTransparency = 1
                    local stroke = obj:FindFirstChildOfClass("UIStroke")
                    if stroke then stroke:Destroy() end
                end
            end
        end
        if obj:IsA("BillboardGui") then
            local n = obj.Name:lower()
            if n:find("overhead") or n:find("nametag") or n:find("grouptag") or n:find("playertag") then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("Frame") and child.BackgroundTransparency < 1 then
                        child.BackgroundTransparency = 1
                    end
                    if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                        local t = (child.Text or ""):lower()
                        if t:find("content creator") or child.Name:lower():find("tag") then
                            child.BackgroundTransparency = 1
                            local stroke = child:FindFirstChildOfClass("UIStroke")
                            if stroke then stroke:Destroy() end
                        end
                    end
                end
            end
        end
    end
end

local function findNativeTagRoot(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BillboardGui") then
            local n = obj.Name:lower()
            if n:find("overhead") or n:find("nametag") or n:find("grouptag") or n:find("playertag") then
