end

local function installCCHook()
    if ccHooked or not ClientState or not ClientState.Update then return end
    ccHooked = true
    local origUpdate = ClientState.Update
    ClientState.Update = function(self, patch)
        local ret = origUpdate(self, patch)
        if ccOn and CCConfig and self.Data then
            self.Data.ContentCreator = true
            self.Data.ManualContentCreator = true
            self.Data.DisplayTag = CCConfig.label
            self.Data.ChatPrefix = CCConfig.chatPrefix
            self.Data.GroupRank = CCConfig.rank
            self.Data.ActiveGroupTag = CCConfig.key
        end
        return ret
    end
end

local function installRankHook()
